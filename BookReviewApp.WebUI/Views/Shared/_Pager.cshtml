@using BookReviewApp.Entities.Models
@model (int Page, int TotalPages, Func<int, object> RouteValues)

@if (Model.TotalPages > 1)
{
    const int window = 2; // pages shown either side of the current one
    var start = Math.Max(1, Model.Page - window);
    var end = Math.Min(Model.TotalPages, Model.Page + window);

    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@(ToDictionary(Model.RouteValues(Model.Page - 1)))" aria-label="Previous">&laquo;</a>
            </li>

            @if (start > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@(ToDictionary(Model.RouteValues(1)))">1</a></li>
                @if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            }

            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")" aria-current="@(i == Model.Page ? "page" : null)">
                    <a class="page-link" asp-action="Index" asp-all-route-data="@(ToDictionary(Model.RouteValues(i)))">@i</a>
                </li>
            }

            @if (end < Model.TotalPages)
            {
                @if (end < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@(ToDictionary(Model.RouteValues(Model.TotalPages)))">@Model.TotalPages</a></li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@(ToDictionary(Model.RouteValues(Model.Page + 1)))" aria-label="Next">&raquo;</a>
            </li>
        </ul>
    </nav>
}

@functions {
    static IDictionary<string, string?> ToDictionary(object values) =>
        values.GetType().GetProperties()
              .Where(p => p.GetValue(values) is not null)
              .ToDictionary(p => p.Name, p => p.GetValue(values)?.ToString());
}